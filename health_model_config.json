{
  "modelVersion": "1.0.0",
  "description": "Central configuration for the EPL Computed Health model. Weights, labels, thresholds, colors and alert limits live only here.",
  "ratingScale": {
    "4": {"label": "Healthy", "description": "On plan with no material intervention needed."},
    "3": {"label": "Watch", "description": "Minor variance with a credible action plan."},
    "2": {"label": "At risk", "description": "Material issue requiring management attention."},
    "1": {"label": "Critical", "description": "Serious issue without a reliable recovery path."},
    "0": {"label": "Failed or blocked", "description": "The commitment or outcome cannot currently be achieved."}
  },
  "maxRating": 4,
  "groups": {
    "project": {"label": "Project Health", "weight": 60},
    "client": {"label": "Client Health", "weight": 40}
  },
  "dimensions": [
    {"key": "schedule", "group": "project", "label": "Schedule and milestone performance", "weight": 10,
     "fields": ["Schedule Health"], "tooltip": "Milestone and schedule performance against plan."},
    {"key": "budget", "group": "project", "label": "Budget, hours, and forecast", "weight": 8,
     "fields": ["Budget Health"], "tooltip": "Hours and budget burn versus forecast."},
    {"key": "scope", "group": "project", "label": "Scope and change control", "weight": 8,
     "fields": ["Scope Health"], "tooltip": "Scope stability and change-control discipline."},
    {"key": "testing", "group": "project", "label": "Testing and solution quality", "weight": 10,
     "fields": ["Testing and Quality Health", "Testing Health", "Quality Health"], "tooltip": "Testing progress and solution quality."},
    {"key": "risks", "group": "project", "label": "Risks, issues, and dependencies", "weight": 8,
     "fields": ["Risk and Dependency Health", "Risks and Dependencies Health"], "tooltip": "Open risks, issues and dependencies."},
    {"key": "tylerTeam", "group": "project", "label": "Tyler team capacity and continuity", "weight": 6,
     "fields": ["Tyler Team Health"], "tooltip": "Tyler staffing capacity and continuity."},
    {"key": "controlPoint", "group": "project", "label": "Control Points, sign-offs, and audit compliance", "weight": 10,
     "fields": ["Control Point Health"], "structured": true,
     "tooltip": "Calculated from structured Control Point data when present; otherwise the manually entered rating is used."},
    {"key": "sponsor", "group": "client", "label": "Executive sponsorship and governance", "weight": 8,
     "fields": ["Sponsor and Governance Health"], "tooltip": "Executive sponsor engagement and governance."},
    {"key": "participation", "group": "client", "label": "Participation and decision timeliness", "weight": 8,
     "fields": ["Participation and Decision Health"], "tooltip": "Client participation and speed of decisions."},
    {"key": "readiness", "group": "client", "label": "Client deliverables and resource readiness", "weight": 8,
     "fields": ["Client Readiness Health"], "tooltip": "Client deliverables and resource readiness."},
    {"key": "adoption", "group": "client", "label": "Training, adoption, and change readiness", "weight": 8,
     "fields": ["Adoption and Training Health"], "tooltip": "Training, adoption and change readiness."},
    {"key": "sentiment", "group": "client", "label": "Sentiment, confidence, and trust", "weight": 8,
     "fields": ["Client Sentiment Health"], "tooltip": "Client sentiment, confidence and trust (rating only; no narrative is published)."}
  ],
  "statuses": {
    "green": {"label": "Green", "icon": "✔", "color": "#0f7b4f", "min": 85},
    "yellow": {"label": "Yellow", "icon": "▲", "color": "#a06a00", "min": 70},
    "orange": {"label": "Orange", "icon": "◆", "color": "#c2570c", "min": 55},
    "red": {"label": "Red", "icon": "✖", "color": "#c53030", "min": 0},
    "gray": {"label": "Incomplete", "icon": "○", "color": "#5b6472", "min": null}
  },
  "statusOrder": ["green", "yellow", "orange", "red"],
  "assessmentFields": {
    "assessmentDate": ["Health Assessment Date"],
    "stage": ["Current Implementation Stage"],
    "override": ["Health Override"],
    "overrideReason": ["Health Override Reason"],
    "recoveryOwner": ["Recovery Owner"],
    "recoveryTargetDate": ["Recovery Target Date"]
  },
  "controlPointFields": {
    "requiredArtifacts": {"labels": ["Required Artifacts"], "type": "count"},
    "approvedArtifacts": {"labels": ["Approved Artifacts"], "type": "count"},
    "signOffsDue": {"labels": ["Sign-Offs Due", "Sign Offs Due"], "type": "count"},
    "signOffsCompleted": {"labels": ["Sign-Offs Completed", "Sign Offs Completed"], "type": "count"},
    "overdueSignOffs": {"labels": ["Overdue Sign-Offs", "Overdue Sign Offs"], "type": "count"},
    "maxDaysOverdue": {"labels": ["Maximum Sign-Off Days Overdue", "Max Sign-Off Days Overdue"], "type": "count"},
    "controlsTested": {"labels": ["Controls Tested"], "type": "count"},
    "controlsPassed": {"labels": ["Controls Passed"], "type": "count"},
    "majorFindings": {"labels": ["Major Findings"], "type": "count"},
    "minorFindings": {"labels": ["Minor Findings"], "type": "count"},
    "correctiveActionsDue": {"labels": ["Corrective Actions Due"], "type": "count"},
    "correctiveActionsOnTime": {"labels": ["Corrective Actions Completed On Time"], "type": "count"},
    "mandatoryBypassed": {"labels": ["Mandatory Control Point Bypassed"], "type": "flag"},
    "auditFailed": {"labels": ["Audit Failed"], "type": "flag"},
    "remediationPlanApproved": {"labels": ["Remediation Plan Approved"], "type": "flag", "optional": true},
    "evidenceMissing": {"labels": ["Required Evidence Missing"], "type": "flag", "optional": true},
    "advancedWithoutApproval": {"labels": ["Advanced Without Required Approval"], "type": "flag", "optional": true}
  },
  "controlPoint": {
    "artifactCritical": 75,
    "artifactAtRisk": 90,
    "signOffCriticalDays": 20,
    "signOffAtRiskDays": 10,
    "repeatedMinorFindings": 3,
    "closureExcellent": 90,
    "closureWatch": 80
  },
  "overrideCodes": {
    "blocked-go-live": {"label": "Blocked go-live", "keywords": ["blocked go-live", "blocked go live", "go-live blocked", "go live blocked"],
      "effect": "red", "scope": "overall", "reason": "Go-live is blocked."},
    "critical-issue": {"label": "Critical security, regulatory, production, or data-integrity issue",
      "keywords": ["critical issue", "critical security", "regulatory", "data integrity", "data-integrity", "production outage", "critical production"],
      "effect": "red", "scope": "overall", "reason": "A critical security, regulatory, production, or data-integrity issue is open."},
    "major-audit-failure": {"label": "Unresolved major audit failure", "keywords": ["major audit failure", "audit failure"],
      "effect": "red", "scope": "overall", "reason": "A major audit failure is unresolved."},
    "sponsor-confidence-loss": {"label": "Client sponsor loss of confidence", "keywords": ["loss of confidence", "sponsor confidence", "lost confidence"],
      "effect": "client-red-overall-max-orange", "scope": "client", "reason": "The client executive sponsor has expressed loss of confidence."}
  },
  "derivedOverrides": {
    "dimension-zero": {"label": "A dimension is rated 0 (failed or blocked)", "effect": "red"},
    "multiple-critical": {"label": "Two or more dimensions are rated 1 (critical)", "effect": "red"},
    "control-point-bypassed": {"label": "Mandatory Control Point bypassed or failed", "effect": "red"},
    "audit-failed": {"label": "Audit failed", "effect": "red"}
  },
  "alerts": {
    "staleDays": 14,
    "declineWarningPoints": 10,
    "clientGapPoints": 15,
    "consecutiveDeclines": 3,
    "clientConsecutiveDeclines": 2,
    "testingGoLiveWindowDays": 60,
    "controlPointDeclinePoints": 1,
    "overdueSignOffWarningDays": 10,
    "trendWindowDays": 90
  },
  "alignment": {
    "categories": {
      "aligned": {"label": "Aligned", "icon": "✔", "tone": "ok", "description": "Reported and Computed Health generally agree."},
      "hidden-risk": {"label": "Hidden Risk", "icon": "⚠", "tone": "critical", "description": "Reported Green, Computed Orange or Red."},
      "emerging-concern": {"label": "Emerging Concern", "icon": "▲", "tone": "warn", "description": "Reported Green, Computed Yellow."},
      "escalating-risk": {"label": "Escalating Risk", "icon": "⬆", "tone": "critical", "description": "Reported Yellow, Computed Red."},
      "greater-reported-concern": {"label": "Greater Reported Concern", "icon": "ℹ", "tone": "info", "description": "Reported Red, Computed Green or Yellow."},
      "incomplete": {"label": "Incomplete", "icon": "○", "tone": "muted", "description": "Insufficient structured data to calculate Computed Health."},
      "not-comparable": {"label": "Not Comparable", "icon": "–", "tone": "muted", "description": "Reported status is not Red, Yellow or Green (for example On Hold or Not Started)."}
    },
    "matrix": {
      "green": {"green": "aligned", "yellow": "emerging-concern", "orange": "hidden-risk", "red": "hidden-risk"},
      "yellow": {"green": "aligned", "yellow": "aligned", "orange": "aligned", "red": "escalating-risk"},
      "red": {"green": "greater-reported-concern", "yellow": "greater-reported-concern", "orange": "aligned", "red": "aligned"}
    },
    "severity": {"reported": {"green": 0, "yellow": 1, "red": 3}, "computed": {"green": 0, "yellow": 1, "orange": 2, "red": 3}}
  },
  "publicData": {
    "publishFreeText": false,
    "note": "Free-text override reasons, sentiment narratives and audit narratives are never published. Set publishFreeText only for an authenticated internal build."
  }
}
